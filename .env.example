# 复制为 .env 并填入真实密钥。密钥绝不进入 git 仓库。

# ---------- 大模型（OpenAI 兼容接口）----------
# provider: openai=在线调用 / mock=离线模板生成（零成本降级模式）
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# ---------- 文生图 ----------
# provider: dashscope=通义万相 / local=本地程序化插画（离线降级）
IMAGE_PROVIDER=local
IMAGE_API_KEY=
IMAGE_MODEL=wanx2.1-t2i-turbo

# ---------- 语音合成 ----------
# provider: edge=Edge TTS（免费，需联网）/ off=静音降级
TTS_PROVIDER=edge
